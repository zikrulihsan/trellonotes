{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.edge.tsbuildinfo"
  },
  "include": ["netlify/edge-functions", "netlify/edge-env.d.ts"]
}
